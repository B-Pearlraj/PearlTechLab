# Neon: Console > your project > Connect > copy the connection string
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Any OpenAI-compatible chat API (example below = Groq). Change URL/model for OpenAI, Gemini, etc.
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant

# Password for uploading documents (make it long and random)
ADMIN_TOKEN=change-me

# Your website origin(s), comma separated. Use * only while testing.
ALLOWED_ORIGINS=https://pearltechlab.onrender.com

# Minimum similarity (0-1) for a question to count as "relevant". Raise = stricter.
MIN_SCORE=0.45

# ---- Service-request emails (Brevo, free: https://app.brevo.com) ----
# Verify MAIL_FROM as a sender in Brevo, then create an API key (SMTP & API > API Keys).
BREVO_API_KEY=xkeysib-your-key
MAIL_FROM=bmuthuraj2002@gmail.com
MAIL_FROM_NAME=Pearl-TechLab
OWNER_EMAIL=bmuthuraj2002@gmail.com
# Logo in the email is loaded from SITE_URL/images/Face-PTS.png
SITE_URL=https://pearltechlab.onrender.com
